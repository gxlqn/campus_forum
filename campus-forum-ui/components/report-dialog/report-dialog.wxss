/* 遮罩层 */
.report-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}
.report-mask.show {
  background: rgba(0,0,0,0.5);
  opacity: 1;
  visibility: visible;
}

/* 弹窗主体 */
.report-dialog {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 1001;
}
.report-dialog.show {
  transform: translateY(0);
}

/* 标题 */
.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.close-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 30rpx;
}

/* 分区 */
.section { margin-bottom: 24rpx; }
.section-label {
  font-size: 27rpx;
  color: #666;
  margin-bottom: 14rpx;
  display: block;
}
.required { color: #e74c3c; }

/* 原因标签网格 */
.reason-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.reason-tag {
  padding: 12rpx 24rpx;
  background: #f5f6f7;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #555;
  transition: all 0.2s;
}
.reason-tag.active {
  background: #fff0f0;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
}

/* 详情输入 */
.detail-input {
  width: 100%;
  height: 160rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 27rpx;
  color: #333;
  box-sizing: border-box;
}

/* 图片区域 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.image-item image {
  width: 100%;
  height: 100%;
}
.remove-img {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 38rpx;
  height: 38rpx;
  background: rgba(0,0,0,0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}
.add-image {
  width: 160rpx;
  height: 160rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.plus-icon { font-size: 48rpx; color: #ccc; }
.add-text { font-size: 22rpx; color: #999; }

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  margin-top: 20rpx;
}
.submit-btn.disabled {
  background: #ddd;
  color: #aaa;
}
.submit-btn::after { border: none; }

/* 底部提示 */
.tip-text {
  display: block;
  text-align: center;
  font-size: 23rpx;
  color: #bbb;
  margin-top: 16rpx;
}
