<view class="report-mask {{visible ? 'show' : ''}}" bindtap="onMaskTap" catchtouchmove="preventMove">
  <view class="report-dialog {{visible ? 'show' : ''}}" catchtap="preventBubbling">

    <!-- 标题栏 -->
    <view class="dialog-header">
      <text class="dialog-title">举报内容</text>
      <view class="close-btn" bindtap="onClose">
        <text>✕</text>
      </view>
    </view>

    <!-- 原因选择 -->
    <view class="section">
      <text class="section-label">举报原因 <text class="required">*</text></text>
      <view class="reason-grid">
        <view
          wx:for="{{reasonTypes}}" wx:key="value"
          class="reason-tag {{selectedReason == item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectReason"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 详细描述 -->
    <view class="section">
      <text class="section-label">详细说明（选填）</text>
      <textarea
        class="detail-input"
        placeholder="请描述具体问题，帮助管理员快速处理..."
        maxlength="200"
        value="{{reasonDetail}}"
        bindinput="onReasonInput"
      ></textarea>
    </view>

    <!-- 截图上传 -->
    <view class="section">
      <text class="section-label">上传截图（最多3张）</text>
      <view class="image-list">
        <block wx:for="{{imageList}}" wx:key="index">
          <view class="image-item" data-url="{{item}}" data-idx="{{index}}">
            <image src="{{item}}" mode="aspectFill" bindtap="previewImage"></image>
            <view class="remove-img" data-idx="{{index}}" catchtap="removeImage">✕</view>
          </view>
        </block>
        <view class="add-image" wx:if="{{imageList.length < 3}}" bindtap="chooseImage">
          <text class="plus-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button
      class="submit-btn {{(!selectedReason || submitting) ? 'disabled' : ''}}"
      bindtap="onSubmit"
      disabled="{{!selectedReason || submitting}}"
    >{{submitting ? '提交中...' : '提交举报'}}</button>

    <text class="tip-text">提交后管理员会尽快处理，处理结果将通过消息通知您</text>
  </view>
</view>
