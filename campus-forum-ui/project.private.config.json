        "privacyKey": "getLocation"
      },
      {
        "privacyName": "地址选择",
        "privacyDesc": "用于选择和获取地址信息",
        "privacyKey": "chooseAddress"
      },
      {
        "privacyName": "位置选择",
        "privacyDesc": "用于在地图上选择具体位置",
        "privacyKey": "chooseLocation"
      },
      {
        "privacyName": "兴趣点选择",
        "privacyDesc": "用于选择附近的兴趣点",
