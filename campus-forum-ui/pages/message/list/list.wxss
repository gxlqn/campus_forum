/* 消息列表�?- 青春可爱风格 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #F8F9FE 100%);
  padding: 0;
}

/* ========== 登录提示区域 ========== */
.login-section {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 80rpx 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.login-emoji {
  font-size: 64rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1D29;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.btn-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

/* ========== 页面头部 ========== */
.page-header {
  padding: 40rpx 32rpx 28rpx;
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1A1D29;
  letter-spacing: -1rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.system-action-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin: 0 0 16rpx;
  padding: 0 6rpx;
}

.system-clear-btn {
  width: 152rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a8a 0%, #ff5f7a 100%);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 95, 122, 0.28);
}

/* ========== Tab切换�?========== */
.tab-bar {
  display: flex;
  justify-content: space-around;
  margin: 16rpx 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  box-shadow: 0 2rpx 16rpx rgba(26, 29, 41, 0.06);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 8rpx 20rpx;
  transition: all 0.2s ease;
}

.tab-icon-box {
  position: relative;
  margin-bottom: 10rpx;
}

.tab-emoji {
  font-size: 44rpx;
  transition: transform 0.2s ease;
}

.tab-item.active .tab-emoji {
  transform: scale(1.15);
}

.badge-dot {
  position: absolute;
  top: -6rpx;
  right: -14rpx;
  background: linear-gradient(135deg, #FF4757 0%, #EE3333 100%);
  border-radius: 999rpx;
  min-width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.4);
}

.badge-num {
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 0 6rpx;
}

.tab-label {
  font-size: 22rpx;
  color: #B0B8C9;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-label.active {
  color: #4A90E2;
  font-weight: 700;
}

/* ========== 消息滚动区域 ========== */
.message-scroll {
  height: calc(100vh - 340rpx);
  padding: 0 24rpx;
}

/* ========== 系统通知卡片 ========== */
.notice-list {
  padding: 0 0 24rpx;
}

.notice-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 29, 41, 0.05);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.notice-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #4A90E2 0%, #357ABD 100%);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.notice-card:active::before {
  opacity: 1;
}

.notice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.notice-type-tag {
  background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);
  padding: 6rpx 16rpx;
  border-radius: 28rpx;
}

.tag-text {
  font-size: 20rpx;
  color: #4A90E2;
  font-weight: 600;
}

.notice-time {
  font-size: 22rpx;
  color: #B0B8C9;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D29;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.notice-content {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
}

.unread-indicator {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, #FF4757 0%, #EE3333 100%);
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.2); opacity: 0.7; }
}

/* ========== 互动消息卡片（评�?点赞�?========= */
.interact-list {
  padding: 0 0 24rpx;
}

.interact-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 29, 41, 0.05);
  display: flex;
  align-items: flex-start;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #FFDDE8;
  flex-shrink: 0;
  border: 3rpx solid #FFF5F7;
}

.interact-content {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.interact-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.user-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D29;
}

.interact-time {
  font-size: 22rpx;
  color: #B0B8C9;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.action-badge.like {
  background: linear-gradient(135deg, #FFF0F0 0%, #FFE0E0 100%);
}

.action-badge.comment {
  background: linear-gradient(135deg, #FFF5F7 0%, #E0EAFF 100%);
}

.action-text {
  font-size: 24rpx;
  font-weight: 500;
}

.action-badge.like .action-text {
  color: #FF4757;
}

.action-badge.comment .action-text {
  color: #4A90E2;
}

.post-preview {
  background: #F8F9FE;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
}

.post-preview-text {
  font-size: 24rpx;
  color: #6B7280;
}

.comment-bubble {
  background: #FAFBFC;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  border-left: 4rpx solid #4A90E2;
}

.comment-body {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.5;
}

/* ========== 私信列表 ========== */
.chat-list {
  padding: 0 0 24rpx;
}

.chat-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 29, 41, 0.05);
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.chat-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 226, 0.15);
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.chat-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #FFDDE8;
  border: 3rpx solid #FFF5F7;
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
}

.chat-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.chat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D29;
}

.chat-time {
  font-size: 22rpx;
  color: #B0B8C9;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.chat-msg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-last-msg {
  font-size: 26rpx;
  color: #9CA3AF;
  flex: 1;
  margin-right: 12rpx;
}

.unread-badge {
  background: linear-gradient(135deg, #FF4757 0%, #EE3333 100%);
  border-radius: 999rpx;
  min-width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
  flex-shrink: 0;
}

.unread-num {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 0 8rpx;
}

/* ========== 空状�?========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F3F4F6 0%, #FFDDE8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.5;
}

/* ========== 加载状�?========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #FFDDE8;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ========== 工具�?========== */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

