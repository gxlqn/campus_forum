.container {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.time {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.sender-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.sender {
  font-size: 26rpx;
  color: #4b5563;
}

.content {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.7;
  white-space: pre-wrap;
}

.btn {
  margin-top: 34rpx;
  background: #FF6B9D;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  margin-top: 100rpx;
  color: #9ca3af;
}

