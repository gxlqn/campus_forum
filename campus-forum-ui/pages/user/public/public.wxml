<view class="page">
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">正在加载用户信息...</text>
  </view>

  <view class="content" wx:if="{{!loading && profile}}">
    <view class="profile-card">
      <image class="avatar" src="{{profile.avatar || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="name-row">
        <text class="nickname">{{profile.nickname || profile.username || '用户'}}</text>
        <text class="verify-tag" wx:if="{{profile.isVerified === 1}}">已认证</text>
      </view>
      <text class="school-info">{{profile.college || '未填写学院'}} {{profile.major || ''}} {{profile.grade || ''}}</text>
      <text class="bio" wx:if="{{profile.bio}}">{{profile.bio}}</text>

      <button
        class="follow-btn {{profile.isFollowing ? 'following' : ''}}"
        wx:if="{{!profile.isSelf}}"
        bindtap="onToggleFollow"
      >
        {{profile.isFollowing ? '已关注' : '关注'}}
      </button>
    </view>

    <view class="stat-grid">
      <view class="stat-item">
        <text class="stat-num">{{profile.stats.publishCount || 0}}</text>
        <text class="stat-label">发布</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{profile.stats.followerCount || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{profile.stats.followingCount || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{profile.stats.avgRating || 0}}</text>
        <text class="stat-label">互助评分(1-5)</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{profile.stats.creditScore || profile.creditScore || 100}}</text>
        <text class="stat-label">信誉积分(累计)</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{profile && !profile.isSelf}}">
    <button class="report-btn" bindtap="onShowReport">举报用户</button>
    <button class="chat-btn" bindtap="onStartChat">发起私信</button>
  </view>

  <report-dialog id="reportDialog" visible="{{showReportDialog}}"></report-dialog>
</view>
