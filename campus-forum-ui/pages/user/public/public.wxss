.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f7 0%, #f8f9fe 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.loading-text {
  color: #9ca3af;
  font-size: 28rpx;
}

.content {
  padding-bottom: 130rpx;
}

.profile-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 157, 0.1);
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.2);
  margin-bottom: 20rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.verify-tag {
  font-size: 22rpx;
  color: #16a34a;
  background: #dcfce7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.school-info {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.bio {
  font-size: 26rpx;
  color: #374151;
  text-align: center;
  line-height: 1.6;
  margin-top: 8rpx;
}

.follow-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff6b9d 0%, #a78bfa 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 72rpx;
  height: 72rpx;
}

.follow-btn.following {
  background: #f3f4f6;
  color: #374151;
}

.stat-grid {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 22rpx 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.08);
}

.report-btn,
.chat-btn {
  flex: 1;
  border-radius: 999rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

.report-btn {
  background: #fef2f2;
  color: #dc2626;
}

.chat-btn {
  background: linear-gradient(135deg, #ff6b9d 0%, #a78bfa 100%);
  color: #fff;
}
