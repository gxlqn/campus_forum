<view class="container">
  <view class="tab-row">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-chip {{tab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <view class="record-list" wx:if="{{list.length > 0}}">
    <view class="record-card" wx:for="{{list}}" wx:key="id">
      <view class="row top">
        <text class="title">{{item.title}}</text>
        <text class="status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="row">
        <text class="meta">审核：{{item.auditText}}</text>
        <text class="meta">发布时间：{{item.createTime || '--'}}</text>
      </view>
      <text class="desc">{{item.content || '暂无描述'}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    暂无记录
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
