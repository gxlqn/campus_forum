/* ==================== 容器与背景 ==================== */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #f6f8fb 40%);
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  z-index: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.bg-circle.c1 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  top: -80rpx;
  right: -60rpx;
  animation: float 8s ease-in-out infinite;
}

.bg-circle.c2 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  top: 120rpx;
  left: -40rpx;
  animation: float 10s ease-in-out infinite reverse;
}

.bg-circle.c3 {
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  bottom: -30rpx;
  right: 80rpx;
  animation: float 12s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.05); }
}

/* ==================== 加载状态 ==================== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.spinner-ring {
  width: 100%;
  height: 100%;
  border: 6rpx solid rgba(102, 126, 234, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* ==================== 主滚动区 ==================== */
.main-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 头像卡片区域 ==================== */
.avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0 30rpx;
}

.avatar-wrapper {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  object-fit: cover;
  box-shadow: 
    0 8rpx 32rpx rgba(102, 126, 234, 0.25),
    0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.avatar-wrapper:active .user-avatar {
  transform: scale(0.96);
}

.avatar-edit-badge {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
  border: 4rpx solid #fff;
}

.edit-icon {
  font-size: 26rpx;
}

.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background: linear-gradient(135deg, #667eea, #764ba2, #f093fb) border-box;
  -webkit-mask: 
    linear-gradient(#fff 0 0) padding-box, 
    linear-gradient(#fff 0 0);
  mask-composite: exclude;
  animation: ring-rotate 4s linear infinite;
}

@keyframes ring-rotate {
  to { transform: rotate(360deg); }
}

.avatar-tip {
  font-size: 24rpx;
  color: #9ca3af;
  letter-spacing: 2rpx;
}

/* ==================== 信息卡片通用样式 ==================== */
.info-card {
  margin: 20rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(0, 0, 0, 0.04),
    0 1rpx 3rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.header-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.header-icon-wrap.basic {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
}

.header-icon-wrap.contact {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
}

.header-icon-wrap.school {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
}

.header-icon {
  font-size: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  letter-spacing: 1rpx;
}

/* ==================== 表单项样式 ==================== */
.form-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.form-item.last-item {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.textarea-item {
  border-bottom: none;
}

.item-label {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.label-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.label-text {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
}

.required-mark {
  color: #ef4444;
  font-size: 28rpx;
  margin-left: 6rpx;
  font-weight: bold;
}

.item-input {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 29rpx;
  color: #1F2937;
  transition: all 0.3s ease;
}

.item-input:focus,
.item-input.has-value {
  background: #ffffff;
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.input-placeholder {
  color: #9ca3af;
  font-size: 27rpx;
}

.item-textarea {
  width: 100%;
  min-height: 140rpx;
  max-height: 280rpx;
  background: #f9fafb;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.5;
  transition: all 0.3s ease;
}

.item-textarea:focus,
.item-textarea.has-value {
  background: #ffffff;
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  text-align: right;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.char-count .warn {
  color: #f59e0b;
}

/* ==================== 底部操作区域 ==================== */
.bottom-action {
  padding: 40rpx 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 8rpx 24rpx rgba(102, 126, 234, 0.35),
    0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.save-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  transition: left 0.5s ease;
}

.save-btn:not([disabled]):active::before {
  left: 100%;
}

.save-btn:not([disabled]):active {
  transform: scale(0.97);
  box-shadow: 
    0 4rpx 12rpx rgba(102, 126, 234, 0.3),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.save-btn[disabled] {
  background: linear-gradient(135deg, #d1d5db 0%, #9ca3af 100%);
  box-shadow: none;
}

.save-btn.submitting {
  opacity: 0.85;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.save-tip {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #9ca3af;
  letter-spacing: 1rpx;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}