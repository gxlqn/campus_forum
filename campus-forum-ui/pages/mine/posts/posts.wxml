<view class="container">
  <view class="header">
    <text class="title">我的帖子</text>
    <text class="count">共 {{list.length}} 条</text>
  </view>

  <view class="search-bar">
    <view class="search-inner">
      <text class="search-icon">🔍</text>
      <input class="search-input"
             placeholder="搜索我的帖子"
             value="{{keyword}}"
             confirm-type="search"
             bindinput="onSearchInput"
             bindconfirm="onSearch" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <view class="list" wx:if="{{list.length > 0}}">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="top-row">
        <text class="post-title">{{item.title}}</text>
        <text class="status {{item.auditStatus === 1 ? 'ok' : (item.auditStatus === 2 ? 'reject' : 'wait')}}">{{item.auditText}}</text>
      </view>
      <text class="meta">{{item.createTime || '--'}}</text>
      <text class="desc">{{item.content || '暂无内容'}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无帖子</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
