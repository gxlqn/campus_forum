.container {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fc;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #e5e7eb;
}

.search-icon {
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  padding: 0 8rpx;
  color: #94a3b8;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.count {
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.top-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.post-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.status.ok { background: #e8f7ee; color: #16a34a; }
.status.reject { background: #fdecec; color: #dc2626; }
.status.wait { background: #fff7e6; color: #d97706; }

.meta {
  display: block;
  margin-top: 10rpx;
  color: #999;
  font-size: 22rpx;
}

.desc {
  display: block;
  margin-top: 12rpx;
  color: #555;
  font-size: 26rpx;
}

.empty, .loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}
