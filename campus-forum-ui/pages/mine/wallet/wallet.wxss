.container {
  min-height: 100vh;
  background: #f8f9fe;
  padding: 28rpx;
  box-sizing: border-box;
}

.balance-card,
.charge-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}

.balance-card {
  margin-bottom: 22rpx;
  background: linear-gradient(145deg, #ff6b9d, #ff8a80);
}

.balance-label {
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
}

.balance-amount {
  margin-top: 12rpx;
  display: block;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}

.tip {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.amount-item {
  height: 72rpx;
  border-radius: 14rpx;
  border: 1rpx solid #ffd7e6;
  color: #ff6b9d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.custom-row {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.custom-input {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #efe6eb;
  border-radius: 14rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  background: #fff;
}

.charge-btn {
  width: 180rpx;
  height: 80rpx;
  line-height: 80rpx;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #ff6b9d, #ff8a80);
}
