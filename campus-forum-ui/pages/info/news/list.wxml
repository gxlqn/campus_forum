<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索资讯关键词" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <scroll-view class="category-scroll" scroll-x>
    <view class="category-item {{item === currentCategory ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="*this"
          data-category="{{item}}"
          bindtap="onCategoryTap">
      {{item}}
    </view>
  </scroll-view>

  <view class="news-list">
    <view class="news-item card"
          wx:for="{{list}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail">
      <image wx:if="{{item.coverImage}}" class="cover" src="{{item.coverImage}}" mode="aspectFill"></image>
      <view class="body">
        <text class="title">{{item.title}}</text>
        <text class="summary" wx:if="{{item.summary}}">{{item.summary}}</text>
        <view class="meta">
          <text class="tag">{{item.category || '资讯'}}</text>
          <text class="source">{{item.source || '校园平台'}}</text>
          <text class="time">{{formatTime(item.publishTime || item.createTime)}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无资讯</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
