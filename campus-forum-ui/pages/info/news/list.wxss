.container {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 20rpx;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.search-input {
  flex: 1;
  height: 74rpx;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #FFDDE8;
}

.search-btn {
  margin-left: 10rpx;
  height: 74rpx;
  line-height: 74rpx;
  padding: 0 24rpx;
  background: #FF6B9D;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.category-item {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 24rpx;
  border: 1rpx solid #FFDDE8;
}

.category-item.active {
  background: #dbeafe;
  color: #1d4ed8;
  border-color: #93c5fd;
}

.news-item {
  background: #ffffff;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 280rpx;
}

.body {
  padding: 18rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.4;
}

.summary {
  margin-top: 10rpx;
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.tag {
  background: #e0e7ff;
  color: #4338ca;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.source,
.time {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.empty,
.loading {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  margin-top: 80rpx;
}

