.container {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 20rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 340rpx;
}

.body {
  padding: 22rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.4;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.source,
.time,
.view {
  font-size: 22rpx;
  color: #9ca3af;
}

.summary {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #374151;
  padding: 14rpx;
  background: #f9fafb;
  border-radius: 20rpx;
}

.content {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #1F2937;
  white-space: pre-wrap;
}

.copy-btn {
  margin-top: 30rpx;
  background: #FF6B9D;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  margin-top: 100rpx;
  color: #9ca3af;
}

