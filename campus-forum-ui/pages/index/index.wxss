/* ============================================
   Index Page - 青春可爱风格
   ============================================ */

.container {
  padding: 0 24rpx 40rpx;
  min-height: 100vh;
  position: relative;
}

/* ========== 顶部装饰圆圈 ========== */
.top-decor {
  position: fixed;
  top: -120rpx;
  left: -60rpx;
  right: -60rpx;
  height: 300rpx;
  pointer-events: none;
  z-index: 0;
}

.decor-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.decor-1 {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  top: 40rpx;
  left: 20rpx;
  animation: float 4s ease-in-out infinite;
}

.decor-2 {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #A78BFA, #C4B5FD);
  top: 100rpx;
  right: 60rpx;
  animation: float 5s ease-in-out infinite 0.5s;
}

.decor-3 {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #60A5FA, #93C5FD);
  top: 20rpx;
  right: 180rpx;
  animation: float 3.5s ease-in-out infinite 1s;
}

/* ========== 搜索栏 - 毛玻璃胶囊风 ========== */
.search-bar {
  position: relative;
  z-index: 10;
  margin: 24rpx 0 32rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 24rpx 40rpx;
  box-shadow:
    0 12rpx 32rpx rgba(255, 107, 157, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  transition: all 0.3s ease;
}

.search-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.search-text {
  color: #9CA3AF;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ========== 轮播图 - 精美卡片风格 ========== */
.banner-wrapper {
  position: relative;
  z-index: 10;
  margin-bottom: 36rpx;
}

.banner {
  height: 340rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow:
    0 20rpx 56rpx rgba(255, 107, 157, 0.15),
    0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
}

/* 背景图 */
.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
  /* 默认渐变背景（当图片未加载时显示） */
  background: var(--banner-bg);
  transition: transform 6s ease-out;
}

swiper-item:not([class*="wx-swiper-dots"]) .banner-bg,
.banner-item .banner-bg {
  /* 轮播切换时轻微缩放动画 */
}

/* 渐变遮罩层 - 从底部向上渐变，确保文字可读 */
.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70%;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.65) 0%,
    rgba(0, 0, 0, 0.3) 45%,
    transparent 100%
  );
  z-index: 1;
}

/* 文字内容区 */
.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 36rpx 36rpx 28rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 标签 */
.banner-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  padding: 6rpx 20rpx;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF6B9D, #F472B6);
  border-radius: 20rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

/* 主标题 */
.banner-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.35;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 副标题 */
.banner-subtitle {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
  letter-spacing: 1rpx;
}

/* 查看详情按钮 */
.banner-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 8rpx;
  width: fit-content;
  padding: 10rpx 24rpx 10rpx 16rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 99rpx;
  transition: all 0.25s ease;
}

.banner-action:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

.action-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.action-arrow {
  font-size: 30rpx;
  color: #fff;
  line-height: 1;
}

/* ========== 自定义指示器 ========== */
.banner-indicators {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 0 10rpx;
}

.indicator-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: rgba(200, 200, 210, 0.35);
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.indicator-dot.active {
  width: 44rpx;
  background: linear-gradient(90deg, #FF6B9D, #A78BFA);
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 157, 0.3);
}

/* ========== 快捷入口 - 彩色气泡网格 ========== */
.quick-entries {
  padding: 40rpx 20rpx;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 10;
}

.entry-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  row-gap: 24rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  margin-bottom: 12rpx;
}

.entry-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  margin-bottom: 18rpx;
  box-shadow: 
    0 12rpx 24rpx rgba(0, 0, 0, 0.06), 
    inset 0 4rpx 6rpx rgba(255, 255, 255, 0.6);
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease;
}

.entry-item:active .entry-icon-wrap {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.bg-pink { background: linear-gradient(135deg, #FFE4EC 0%, #FFDDE8 100%); }
.bg-purple { background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%); }
.bg-amber { background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); }
.bg-mint { background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%); }
.bg-sky { background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%); }
.bg-rose { background: linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%); }

.entry-emoji {
  font-size: 48rpx;
}

.entry-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #4B5563;
}

/* ========== 板块标题区 ========== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 20rpx;
  position: relative;
  z-index: 10;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.title-badge {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.section-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #111827;
  letter-spacing: 1rpx;
}

.more-link {
  font-size: 25rpx;
  color: #9CA3AF;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.more-link:active {
  background: rgba(255, 107, 157, 0.1);
  color: #FF6B9D;
}

/* ========== 板块横向滚动 ========== */
.sections-scroll {
  white-space: nowrap;
  padding: 0 0 36rpx;
  position: relative;
  z-index: 10;
}

.section-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 32rpx 32rpx;
  margin-right: 24rpx;
  min-width: 170rpx;
  box-shadow:
    0 12rpx 32rpx -4rpx rgba(255, 107, 157, 0.06),
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
  backdrop-filter: blur(10px);
}

.section-item:active {
  transform: scale(0.94);
  box-shadow: 0 4rpx 16rpx -4rpx rgba(255, 107, 157, 0.04);
}

.section-icon-wrap {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(255, 107, 157, 0.08), rgba(255, 143, 171, 0.08));
  border-radius: 50%;
  margin-bottom: 20rpx;
  font-size: 40rpx;
  position: relative;
}

.section-icon-wrap::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 107, 157, 0.2);
}

.section-name {
  font-size: 28rpx;
  color: #374151;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.section-count {
  font-size: 21rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 帖子卡片列表 ========== */
.post-list {
  padding-bottom: 40rpx;
  position: relative;
  z-index: 10;
}

.post-card {
  margin-bottom: 32rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  box-shadow:
    0 16rpx 40rpx -6rpx rgba(0, 0, 0, 0.05),
    inset 0 4rpx 6rpx rgba(255, 255, 255, 1);
  border: 2rpx solid rgba(243, 244, 246, 0.8);
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.post-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx -6rpx rgba(0, 0, 0, 0.03);
}

.card-top-accent {
  width: 100%;
  height: 8rpx;
  background: linear-gradient(90deg, #FF6B9D, #A78BFA);
  opacity: 0.85;
}

.post-card-body {
  padding: 32rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.author-col {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.post-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 16rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.post-content {
  font-size: 30rpx;
  color: #4B5563;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.post-image {
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF5F7, #F0F0F5);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.post-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed rgba(243, 244, 246, 0.8);
}

.post-stats {
  gap: 20rpx;
  align-items: center;
}

.stat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.stat-dot-pink { background: #FF6B9D; }
.stat-dot-red { background: #F87171; }
.stat-dot-blue { background: #60A5FA; }

.stat-text {
  font-size: 23rpx;
  color: #9CA3AF;
  margin-right: 4rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  position: relative;
  z-index: 10;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  color: #6B7280;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-sub {
  color: #C4B5CD;
  font-size: 25rpx;
}

/* ========== 加载动画 ========== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  position: relative;
  z-index: 10;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B9D;
  animation: bounce 1.4s ease-in-out infinite both;
}

.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
