<!--pages/search/search.wxml - 升级版-->
<view class="container">
  <!-- 顶部装饰 -->
  <view class="top-decor">
    <view class="decor-circle decor-1"></view>
    <view class="decor-circle decor-2"></view>
  </view>

  <!-- 搜索栏 - 毛玻璃胶囊风 -->
  <view class="search-bar-wrap">
    <view class="search-bar glass-panel">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索帖子、商品、活动、互助..."
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
        focus="{{autoFocus}}"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">
        <text class="clear-icon">✕</text>
      </view>
    </view>
    <view class="search-btn" bindtap="onSearch" hover-class="btn-hover">
      <text class="search-btn-text">搜索</text>
    </view>
  </view>

  <!-- 实时搜索建议 -->
  <view class="suggest-dropdown" wx:if="{{showSuggestions && suggestList.length > 0 && !hasSearched}}">
    <view class="suggest-item" wx:for="{{suggestList}}" wx:key="*this" bindtap="tapKeyword" data-keyword="{{item}}">
      <text class="suggest-icon">🔍</text>
      <rich-text class="suggest-text" nodes="{{item.highlight || item}}"></rich-text>
    </view>
  </view>

  <!-- 未搜索状态：展示推荐内容 -->
  <view class="pre-search" wx:if="{{!hasSearched}}">
    <!-- 大家都在搜 - 热门标签云 -->
    <view class="section-card" wx:if="{{hotRecommendKeywords.length > 0}}">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-emoji">🔥</text>
          <text class="section-title">大家都在搜</text>
        </view>
      </view>
      <view class="tag-cloud">
        <view
          wx:for="{{hotRecommendKeywords}}"
          wx:key="*this"
          class="hot-tag hot-tag-{{index % 4}}"
          bindtap="tapKeyword"
          data-keyword="{{item}}"
        >
          <text class="hot-index" wx:if="{{index < 3}}">TOP{{index + 1}}</text>
          <text class="tag-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 历史搜索 -->
    <view class="section-card" wx:if="{{historyKeywords.length > 0}}">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-emoji">🕐</text>
          <text class="section-title">搜索历史</text>
        </view>
        <view class="clear-btn" bindtap="clearHistory" hover-class="btn-hover">
          <text class="clear-icon">🗑️</text>
          <text class="clear-text">清空</text>
        </view>
      </view>
      <view class="history-list">
        <view
          wx:for="{{historyKeywords}}"
          wx:key="*this"
          class="history-item"
          bindtap="tapKeyword"
          data-keyword="{{item}}"
        >
          <text class="history-icon">📌</text>
          <text class="history-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 推荐搜索 -->
    <view class="section-card" wx:if="{{recommendKeywords.length > 0}}">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-emoji">💡</text>
          <text class="section-title">推荐搜索</text>
        </view>
      </view>
      <view class="chips">
        <view
          wx:for="{{recommendKeywords}}"
          wx:key="*this"
          class="chip"
          bindtap="tapKeyword"
          data-keyword="{{item}}"
        >
          <text class="chip-icon">✨</text>
          <text class="chip-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 已搜索状态：展示结果 -->
  <view class="search-results" wx:if="{{hasSearched}}">
    <!-- 搜索结果统计 -->
    <view class="result-stats" wx:if="{{!loading}}">
      <text class="stats-text">找到 <text class="stats-num">{{totalCount}}</text> 个结果</text>
    </view>

    <!-- 拼写纠正提示 -->
    <view class="suggest-block" wx:if="{{correctedKeyword}}">
      <view class="suggest-card">
        <text class="suggest-icon">💡</text>
        <view class="suggest-content">
          <text class="suggest-label">你是不是想搜：</text>
          <text class="suggest-keyword" bindtap="tapKeyword" data-keyword="{{correctedKeyword}}">{{correctedKeyword}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="result-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <!-- 综合结果（优先展示） -->
      <view class="result-block" wx:if="{{merged.length > 0}}">
        <view class="block-header">
          <text class="block-title">综合结果</text>
        </view>
        <view
          wx:for="{{merged}}"
          wx:key="id"
          class="result-card"
          bindtap="goToMerged"
          data-id="{{item.id}}"
          data-type="{{item.type}}"
          hover-class="card-hover"
        >
          <view class="card-accent card-accent-{{item.type}}"></view>
          <view class="card-body">
            <view class="card-top-row">
              <view class="type-badge type-badge-{{item.type}}">
                <text class="badge-icon">{{item.typeIcon}}</text>
                <text class="badge-text">{{item.typeLabel}}</text>
              </view>
              <text class="meta-text" wx:if="{{item.meta}}">{{item.meta}}</text>
            </view>
            <rich-text class="card-title" nodes="{{item.displayTitle || item.title}}"></rich-text>
            <rich-text class="card-desc" nodes="{{item.displayDesc || item.snippet}}"></rich-text>
            <view class="card-footer">
              <text class="footer-item" wx:if="{{item.authorName}}">✍️ {{item.authorName}}</text>
              <text class="footer-item" wx:if="{{item.time}}">🕐 {{item.time}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 分类结果：帖子 -->
      <view class="result-block" wx:if="{{posts.length > 0}}">
        <view class="block-header">
          <text class="block-title">📝 帖子</text>
          <text class="block-count">{{posts.length}}个</text>
        </view>
        <view
          wx:for="{{posts}}"
          wx:key="id"
          class="result-card"
          bindtap="goToPost"
          data-id="{{item.id}}"
          hover-class="card-hover"
        >
          <view class="card-accent card-accent-post"></view>
          <view class="card-body">
            <rich-text class="card-title" nodes="{{item.displayTitle || item.title}}"></rich-text>
            <rich-text class="card-desc" nodes="{{item.displayDesc || item.content}}"></rich-text>
            <view class="card-footer">
              <text class="footer-item">📂 {{item.sectionName}}</text>
              <text class="footer-item">✍️ {{item.author.nickname}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 分类结果：商品 -->
      <view class="result-block" wx:if="{{products.length > 0}}">
        <view class="block-header">
          <text class="block-title">🛒 商品</text>
          <text class="block-count">{{products.length}}个</text>
        </view>
        <view
          wx:for="{{products}}"
          wx:key="id"
          class="result-card"
          bindtap="goToProduct"
          data-id="{{item.id}}"
          hover-class="card-hover"
        >
          <view class="card-accent card-accent-product"></view>
          <view class="card-body">
            <rich-text class="card-title" nodes="{{item.displayTitle || item.title}}"></rich-text>
            <rich-text class="card-desc" nodes="{{item.displayDesc || item.description}}"></rich-text>
            <view class="card-footer">
              <text class="price-text">¥{{item.price}}</text>
              <text class="footer-item">✍️ {{item.seller.nickname}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 分类结果：活动 -->
      <view class="result-block" wx:if="{{activities.length > 0}}">
        <view class="block-header">
          <text class="block-title">🎉 活动</text>
          <text class="block-count">{{activities.length}}个</text>
        </view>
        <view
          wx:for="{{activities}}"
          wx:key="id"
          class="result-card"
          hover-class="card-hover"
        >
          <view class="card-accent card-accent-activity"></view>
          <view class="card-body">
            <rich-text class="card-title" nodes="{{item.displayTitle || item.title}}"></rich-text>
            <rich-text class="card-desc" nodes="{{item.displayDesc || item.description}}"></rich-text>
            <view class="card-footer">
              <text class="footer-item" wx:if="{{item.time}}">🕐 {{item.time}}</text>
              <text class="footer-item" wx:if="{{item.location}}">📍 {{item.location}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 分类结果：互助 -->
      <view class="result-block" wx:if="{{helps.length > 0}}">
        <view class="block-header">
          <text class="block-title">🤝 互助</text>
          <text class="block-count">{{helps.length}}个</text>
        </view>
        <view
          wx:for="{{helps}}"
          wx:key="id"
          class="result-card"
          hover-class="card-hover"
        >
          <view class="card-accent card-accent-help"></view>
          <view class="card-body">
            <rich-text class="card-title" nodes="{{item.displayTitle || item.title}}"></rich-text>
            <rich-text class="card-desc" nodes="{{item.displayDesc || item.description}}"></rich-text>
            <view class="card-footer">
              <text class="footer-item" wx:if="{{item.location}}">📍 {{item.location}}</text>
              <text class="footer-item" wx:if="{{item.time}}">🕐 {{item.time}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 热门板块推荐 -->
      <view class="result-block" wx:if="{{sections.length > 0 && !loading}}">
        <view class="block-header">
          <text class="block-title">📚 相关板块</text>
        </view>
        <view class="section-chips">
          <view wx:for="{{sections}}" wx:key="id" class="section-chip">
            <text class="section-icon">{{item.icon || '💬'}}</text>
            <text class="section-name">{{item.sectionName}}</text>
            <text class="section-count">{{item.postCount || 0}}帖</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!loading && totalCount === 0}}">
        <text class="empty-emoji">🔍</text>
        <text class="empty-title">未找到相关结果</text>
        <text class="empty-desc">换个关键词试试吧～</text>
        <view class="empty-suggest">
          <text class="suggest-label">热门搜索：</text>
          <view class="suggest-tags">
            <text
              wx:for="{{hotRecommendKeywords}}"
              wx:key="*this"
              class="suggest-tag"
              bindtap="tapKeyword"
              data-keyword="{{item}}"
            >{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 加载中 -->
      <view class="loading-state" wx:if="{{loading}}">
        <view class="loading-skeleton">
          <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
            <view class="skeleton-line title"></view>
            <view class="skeleton-line desc"></view>
            <view class="skeleton-line meta"></view>
          </view>
        </view>
      </view>

      <!-- 底部安全区 -->
      <view class="bottom-safe"></view>
    </scroll-view>
  </view>
</view>
