/* ============================================
   Search Page - ui-ux-pro-max 升级版
   ============================================ */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #FFF0F5 40%, #F8F9FE 100%);
  padding: 0 24rpx 40rpx;
  position: relative;
}

/* ========== 顶部装饰 ========== */
.top-decor {
  position: fixed;
  top: -80rpx;
  left: -40rpx;
  right: -40rpx;
  height: 240rpx;
  pointer-events: none;
  z-index: 0;
}

.decor-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.12;
}

.decor-1 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  top: 20rpx;
  left: 40rpx;
  animation: float 5s ease-in-out infinite;
}

.decor-2 {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #A78BFA, #C4B5FD);
  top: 60rpx;
  right: 80rpx;
  animation: float 4s ease-in-out infinite 1s;
}

/* ========== 搜索栏容器 ========== */
.search-bar-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  background: linear-gradient(180deg, #FFF5F7 0%, rgba(255, 245, 247, 0.95) 100%);
  backdrop-filter: blur(10px);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 12rpx 32rpx rgba(255, 107, 157, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  transition: all 0.3s ease;
}

.search-bar:focus-within {
  border-color: rgba(255, 107, 157, 0.3);
  box-shadow:
    0 12rpx 32rpx rgba(255, 107, 157, 0.15),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  background: transparent;
}

.search-placeholder {
  color: #C4B5CD;
  font-size: 28rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(156, 163, 175, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.clear-icon {
  font-size: 22rpx;
  color: #6B7280;
}

.search-btn {
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FAB 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 157, 0.35);
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.search-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 10rpx rgba(255, 107, 157, 0.3);
}

.search-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ========== 实时搜索建议下拉 ========== */
.suggest-dropdown {
  position: relative;
  z-index: 99;
  margin-top: -8rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.suggest-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(243, 244, 246, 0.8);
  transition: background 0.2s ease;
}

.suggest-item:last-child {
  border-bottom: none;
}

.suggest-item:active {
  background: rgba(255, 107, 157, 0.05);
}

.suggest-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.suggest-text {
  font-size: 28rpx;
  color: #374151;
  flex: 1;
}

/* ========== 搜索前状态 ========== */
.pre-search {
  position: relative;
  z-index: 1;
}

/* ========== 通用区块卡片 ========== */
.section-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow:
    0 12rpx 36rpx rgba(255, 107, 157, 0.06),
    0 4rpx 12rpx rgba(167, 139, 250, 0.03),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  animation: slideUp 0.4s ease-out;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 1rpx;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 157, 0.08);
  transition: all 0.2s ease;
}

.clear-btn:active {
  background: rgba(255, 107, 157, 0.15);
  transform: scale(0.96);
}

.clear-icon {
  font-size: 24rpx;
}

.clear-text {
  font-size: 24rpx;
  color: #FF6B9D;
  font-weight: 500;
}

/* ========== 大家都在搜 - 标签云 ========== */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  border: 2rpx solid transparent;
}

.hot-tag:active {
  transform: scale(0.92);
}

.hot-tag-0 {
  background: linear-gradient(135deg, #FFE4EC, #FFDDE8);
  color: #E11D48;
  border-color: rgba(225, 29, 72, 0.15);
  box-shadow: 0 4rpx 12rpx rgba(225, 29, 72, 0.12);
}

.hot-tag-1 {
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  color: #7C3AED;
  border-color: rgba(124, 58, 237, 0.15);
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.12);
}

.hot-tag-2 {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #D97706;
  border-color: rgba(217, 119, 6, 0.15);
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.12);
}

.hot-tag-3 {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
  color: #059669;
  border-color: rgba(5, 150, 105, 0.15);
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.12);
}

.hot-index {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.6);
}

.tag-text {
  font-size: 26rpx;
}

/* ========== 历史搜索 ========== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.history-item:active {
  background: rgba(255, 107, 157, 0.05);
  transform: translateX(8rpx);
}

.history-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.history-text {
  font-size: 28rpx;
  color: #4B5563;
}

/* ========== 推荐搜索芯片 ========== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 107, 157, 0.15);
  color: #4B5563;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
}

.chip:active {
  transform: scale(0.92);
  background: rgba(255, 107, 157, 0.08);
  border-color: rgba(255, 107, 157, 0.3);
}

.chip-icon {
  font-size: 24rpx;
}

.chip-text {
  font-size: 26rpx;
}

/* ========== 搜索结果区 ========== */
.search-results {
  position: relative;
  z-index: 1;
}

.result-stats {
  padding: 16rpx 0 24rpx;
}

.stats-text {
  font-size: 26rpx;
  color: #9CA3AF;
}

.stats-num {
  color: #FF6B9D;
  font-weight: 700;
}

/* ========== 拼写纠正 ========== */
.suggest-block {
  margin-bottom: 24rpx;
}

.suggest-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFE4EC, #FFF0F5);
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 107, 157, 0.15);
}

.suggest-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.suggest-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.suggest-label {
  font-size: 26rpx;
  color: #6B7280;
}

.suggest-keyword {
  font-size: 28rpx;
  font-weight: 700;
  color: #E11D48;
  text-decoration: underline;
}

/* ========== 结果区块 ========== */
.result-block {
  margin-bottom: 32rpx;
}

.block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 1rpx;
}

.block-count {
  font-size: 24rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* ========== 结果卡片 ========== */
.result-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow:
    0 8rpx 24rpx -4rpx rgba(0, 0, 0, 0.05),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.result-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx -4rpx rgba(0, 0, 0, 0.03);
}

.card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx -4rpx rgba(0, 0, 0, 0.03);
}

.card-accent {
  height: 6rpx;
  opacity: 0.8;
}

.card-accent-post {
  background: linear-gradient(90deg, #FF6B9D, #FF8FAB);
}

.card-accent-product {
  background: linear-gradient(90deg, #A78BFA, #C4B5FD);
}

.card-accent-activity {
  background: linear-gradient(90deg, #FBBF24, #FCD34D);
}

.card-accent-help {
  background: linear-gradient(90deg, #34D399, #6EE7B7);
}

.card-body {
  padding: 24rpx 28rpx;
}

.card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.type-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.type-badge-post {
  background: linear-gradient(135deg, #FFE4EC, #FFDDE8);
  color: #E11D48;
}

.type-badge-product {
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  color: #7C3AED;
}

.type-badge-activity {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #D97706;
}

.type-badge-help {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
  color: #059669;
}

.badge-icon {
  font-size: 20rpx;
}

.badge-text {
  font-size: 22rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.5;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.card-desc {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(243, 244, 246, 0.8);
}

.footer-item {
  font-size: 22rpx;
  color: #9CA3AF;
}

.price-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #E11D48;
}

/* ========== 热门板块标签 ========== */
.section-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.section-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(167, 139, 250, 0.15);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.section-chip:active {
  transform: scale(0.95);
}

.section-icon {
  font-size: 24rpx;
}

.section-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.section-count {
  font-size: 20rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 32rpx;
}

.empty-suggest {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.suggest-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.suggest-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.suggest-tag {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 157, 0.08);
  color: #FF6B9D;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.suggest-tag:active {
  transform: scale(0.92);
  background: rgba(255, 107, 157, 0.15);
}

/* ========== 骨架屏加载 ========== */
.loading-state {
  padding: 20rpx 0;
}

.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 28rpx;
  overflow: hidden;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #F3F4F6 25%, #E5E7EB 50%, #F3F4F6 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-line.title {
  width: 70%;
  height: 32rpx;
}

.skeleton-line.desc {
  width: 100%;
  height: 24rpx;
}

.skeleton-line.meta {
  width: 50%;
  height: 20rpx;
}

/* ========== 结果滚动区 ========== */
.result-scroll {
  height: calc(100vh - 200rpx);
}

.bottom-safe {
  height: 60rpx;
}

/* ========== 动画 ========== */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

@keyframes slideUp {
  from { transform: translateY(30rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* ========== rich-text 行内样式 ========== */
.rich-line {
  display: block;
}
