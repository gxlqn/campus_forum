/* 发帖页样�?*/

.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.form-item {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

/* 选择�?*/
.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 标题输入 */
.title-input {
  font-size: 32rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

/* 内容输入 */
.content-input {
  width: 100%;
  min-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 16rpx 0;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.upload-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.remove-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #F5F5F5;
  border-radius: 20rpx;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 64rpx;
  color: #CCCCCC;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 发布按钮 */
.submit-btn {
  margin-top: 40rpx;
}

/* 提示 */
.tips {
  margin-top: 30rpx;
  padding: 20rpx;
}

.tips text {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
}

.tips text:first-child {
  font-weight: 500;
  color: #666666;
  margin-bottom: 8rpx;
}

