<view class="container">
  <!-- 板块选择 -->
  <view class="form-item card">
    <text class="form-label">板块</text>
    <picker mode="selector" range="{{sections}}" range-key="sectionName" bindchange="onSectionChange">
      <view class="picker-value">
        <text>{{sectionName}}</text>
        <text class="picker-arrow">></text>
      </view>
    </picker>
  </view>

  <!-- 标题输入 -->
  <view class="form-item card">
    <input class="title-input" placeholder="请输入标题" maxlength="50" value="{{title}}" bindinput="onTitleInput"/>
    <text class="char-count">{{title.length}}/50</text>
  </view>

  <!-- 内容输入 -->
  <view class="form-item card">
    <textarea class="content-input" placeholder="分享你的想法..." maxlength="2000" value="{{content}}" bindinput="onContentInput"/>
  </view>

  <!-- 图片上传 -->
  <view class="form-item card">
    <text class="form-label">图片</text>
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image class="upload-image" src="{{item}}" mode="aspectFill"></image>
        <view class="remove-btn" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
      <view class="add-image" bindtap="chooseImage" wx:if="{{images.length < 9}}">
        <text class="add-icon">+</text>
      </view>
    </view>
  </view>

  <!-- 匿名开关 -->
  <view class="form-item card flex-between">
    <text class="form-label">匿名发布</text>
    <switch checked="{{isAnonymous}}" bindchange="toggleAnonymous" color="#4A90D9"/>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn btn-primary" loading="{{submitting}}" bindtap="submit">发布帖子</button>
</view>