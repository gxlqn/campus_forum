/* ============================================
   Forum List - 青春可爱风格
   ============================================ */

.container {
  padding: 0 24rpx 140rpx;
  min-height: 100vh;
}

/* ========== 页面标题 ========== */
.page-header {
  padding: 28rpx 0 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1F2937;
  letter-spacing: 2rpx;
  display: block;
}

.page-subtitle {
  font-size: 25rpx;
  color: #C4B5CD;
  margin-top: 6rpx;
  display: block;
}

/* ========== 搜索�?========== */
.search-bar {
  margin-bottom: 20rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
}

.search-placeholder {
  color: #D4C5D9;
  font-size: 27rpx;
}

/* ========== 板块标签 - 胶囊�?========== */
.section-tabs {
  white-space: nowrap;
  padding: 8rpx 0 20rpx;
}

.tab-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
}

.tab-chip.active {
  background: linear-gradient(135deg, #FF6B9D, #FF8FAB);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
  border-color: transparent;
  font-weight: 600;
}

.tab-chip text {
  letter-spacing: 1rpx;
}

/* ========== 排序�?========== */
.order-bar {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0 24rpx;
}

.order-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #9CA3AF;
  background: #FFFFFF;
  border: 2rpx solid #F3F4F6;
  transition: all 0.2s ease;
}

.order-chip.active {
  color: #FF6B9D;
  border-color: #FFE4EC;
  background: linear-gradient(135deg, #FFF5F7, #FFFFFF);
  font-weight: 600;
}

.order-chip text {
  margin-right: 6rpx;
}

/* ========== 帖子卡片 ========== */
.post-list { padding-bottom: 20rpx; }

.post-card {
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow:
    0 4rpx 18rpx rgba(255, 107, 157, 0.08),
    0 1rpx 3rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  transition: transform 0.2s ease;
}

.post-card:active { transform: scale(0.98); }

.card-accent {
  height: 5rpx;
  background: linear-gradient(90deg, #FF6B9D 0%, #A78BFA 50%, #60A5FA 100%);
  opacity: 0.45;
}

.post-body {
  padding: 22rpx 26rpx 18rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-info {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 27rpx;
  color: #374151;
  font-weight: 600;
}

.post-time {
  font-size: 21rpx;
  color: #C4B5CD;
  margin-top: 4rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.55;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.post-content {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
  margin-bottom: 14rpx;
}

.post-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
  position: relative;
}

.post-img {
  width: 190rpx;
  height: 190rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FFF5F7, #F0F0F5);
}

.img-more-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-more-badge text {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.post-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 107, 157, 0.07);
}

.stats-row {
  gap: 20rpx;
  align-items: center;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 23rpx;
  color: #9CA3AF;
}

.stat-icon {
  font-size: 22rpx;
}

/* ========== 底部提示 ========== */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 16rpx;
}

.no-more-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 107, 157, 0.2));
}

.no-more-line:last-child {
  background: linear-gradient(90deg, rgba(255, 107, 157, 0.2), transparent);
}

.no-more-text {
  font-size: 23rpx;
  color: #C4B5CD;
  white-space: nowrap;
}

/* ========== 空状�?========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  color: #6B7280;
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-sub {
  color: #C4B5CD;
  font-size: 24rpx;
}

/* ========== 加载动画 ========== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B9D;
  animation: bounce 1.4s ease-in-out infinite both;
}
.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ========== 发帖悬浮按钮 - 气泡�?========== */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FF6B9D, #FF8FAB);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(255, 107, 157, 0.4),
    0 2rpx 8rpx rgba(255, 107, 157, 0.2);
  z-index: 100;
  animation: fab-pulse 2.5s ease-in-out infinite;
}

.fab-btn:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

.fab-icon {
  font-size: 44rpx;
}

@keyframes fab-pulse {
  0%, 100% { box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.4), 0 2rpx 8rpx rgba(255, 107, 157, 0.2); }
  50% { box-shadow: 0 8rpx 40rpx rgba(255, 107, 157, 0.5), 0 4rpx 16rpx rgba(255, 107, 157, 0.3); }
}

