<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">💬 校园论坛</text>
    <text class="page-subtitle">发现有趣的话题</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-inner">
      <text class="search-icon">🔍</text>
      <input class="search-input"
             placeholder="搜索帖子..."
             value="{{searchKeyword}}"
             confirm-type="search"
             placeholder-class="search-placeholder"
             bindinput="onSearchInput"
             bindconfirm="onSearch"/>
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 板块标签 - 可爱胶囊风 -->
  <scroll-view class="section-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-chip {{currentSection === '' ? 'active' : ''}}" 
          bindtap="onSectionTap" 
          data-id="">
      <text>✨ 全部</text>
    </view>
    <view class="tab-chip {{currentSection === item.id ? 'active' : ''}}" 
          wx:for="{{sections}}" 
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSectionTap">
      <text>{{item.sectionName}}</text>
    </view>
  </scroll-view>

  <!-- 排序标签 -->
  <view class="order-bar">
    <view class="order-chip {{orderBy === 'latest' ? 'active' : ''}}" 
          bindtap="onOrderTap" 
          data-order="latest">
      <text>🕐 最新</text>
    </view>
    <view class="order-chip {{orderBy === 'hot' ? 'active' : ''}}" 
          bindtap="onOrderTap" 
          data-order="hot">
      <text>🔥 最热</text>
    </view>
  </view>

  <!-- 搜索结果提示 -->
  <view class="search-status" wx:if="{{searchKeyword}}">
    <text class="search-status-text">搜索 "{{searchKeyword}}" 的结果</text>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list">
    <view class="post-card" 
          wx:for="{{posts}}" 
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goToDetail">
      <view class="card-accent"></view>
      <view class="post-body">
        <view class="post-header">
          <image class="avatar avatar-sm" src="{{item.author.avatar || '/static/images/default-avatar.png'}}" catchtap="goToUserProfile" data-user-id="{{item.author.id || item.userId}}"></image>
          <view class="author-info">
            <text class="author-name">{{item.author.nickname || '匿名用户'}}</text>
            <text class="post-time">{{item.createTime}}</text>
          </view>
        </view>

        <view class="post-title ellipsis-2">{{item.title}}</view>
        <view class="post-content ellipsis-2" wx:if="{{item.content}}">{{item.content}}</view>

        <view class="post-images" wx:if="{{item.imageList && item.imageList.length > 0}}">
          <image class="post-img" 
                 wx:for="{{item.imageList}}" 
                 wx:for-item="img" 
                 wx:key="index"
                 wx:if="{{index < 3}}"
                 src="{{img}}" 
                 mode="aspectFill"></image>
          <view class="img-more-badge" wx:if="{{item.imageList.length > 3}}">
            <text>+{{item.imageList.length - 3}}</text>
          </view>
        </view>

        <view class="post-footer flex-between">
          <view class="tag tag-primary">{{item.section.sectionName}}</view>
          <view class="stats-row flex">
            <view class="stat-item">
              <text class="stat-icon">👁</text>
              <text>{{item.viewCount || 0}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">❤️</text>
              <text>{{item.likeCount || 0}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">💬</text>
              <text>{{item.commentCount || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 无更多 -->
  <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
    <view class="no-more-line"></view>
    <text class="no-more-text">~ 到底啦 ~</text>
    <view class="no-more-line"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
    <text class="empty-emoji">🌿</text>
    <text class="empty-text">这里空空的~</text>
    <text class="empty-sub">来发个帖子吧！</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot dot-1"></view>
      <view class="dot dot-2"></view>
      <view class="dot dot-3"></view>
    </view>
  </view>

  <!-- 发帖按钮 - 悬浮气泡风 -->
  <view class="fab-btn" bindtap="goToPublish">
    <text class="fab-icon">✏️</text>
  </view>
</view>
