/* ========== 帖子详情�?- 青春可爱风格交�?========== */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #F8F9FE 50%, #FAFBFC 100%);
}

/* 滚动区域 */
.post-scroll {
  height: calc(100vh - 120rpx);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 帖子卡片 ========== */
.post-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 29, 41, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

/* 作者信息区 */
.author-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.author-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.author-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #E8ECF4;
  flex-shrink: 0;
  background: #F3F4F6;
}

.author-meta {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D29;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-sub {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  gap: 6rpx;
}

.post-time {
  font-size: 24rpx;
  color: #9BA3AF;
}

.time-dot {
  font-size: 24rpx;
  color: #D1D5DB;
}

.post-section {
  font-size: 24rpx;
  color: #6366F1;
}

.section-badge {
  background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #A78BFA;
  font-weight: 500;
}

/* 帖子标题 */
.post-title-area {
  margin-bottom: 24rpx;
}

.post-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1A1D29;
  line-height: 1.5;
  letter-spacing: -0.5rpx;
  word-break: break-all;
}

/* 帖子正文 */
.post-body {
  margin-bottom: 28rpx;
}

.post-content {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.85;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 图片展示�?*/
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.grid-image {
  border-radius: 28rpx;
  background: #F3F4F6;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.08);
}

.grid-image.single {
  width: 100%;
  max-height: 600rpx;
  border-radius: 20rpx;
}

.grid-image.double {
  width: calc(50% - 6rpx);
  height: 320rpx;
}

.grid-image.multi {
  width: calc(33.33% - 8rpx);
  height: 220rpx;
}

/* ========== 互动�?- 可爱风�?========== */
.interaction-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  background: linear-gradient(135deg, #FAFBFC 0%, #F8F9FE 100%);
  border-radius: 20rpx;
  border: 1rpx solid #EEF2F7;
  margin-top: 12rpx;
}

/* 左侧：浏�?+ 评论 */
.interaction-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.inter-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.inter-icon {
  font-size: 28rpx;
  opacity: 0.8;
}

.inter-num {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}

.inter-divider {
  width: 1rpx;
  height: 28rpx;
  background: #D1D5DB;
  opacity: 0.5;
}

/* 右侧：点�?+ 收藏 */
.interaction-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* ========== 青春可爱风格点赞按�?========== */
.bili-like-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  background: transparent;
  border-radius: 40rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: visible;
}

.bili-like-btn.like-hover {
  transform: scale(0.95);
  opacity: 0.9;
}

.bili-like-btn.animating {
  pointer-events: none;
}

/* 点赞图标容器 */
.like-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 未点赞状�?- 空心爱心 */
.icon-unliked {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  transition: all 0.3s ease;
}

.icon-unliked.hide {
  opacity: 0;
  transform: scale(0);
}

.heart-outline {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #9CA3AF;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}

.heart-outline::before,
.heart-outline::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 28rpx;
  background: #9CA3AF;
  border-radius: 18rpx 18rpx 0 0;
  top: 6rpx;
}

.heart-outline::before {
  left: 6rpx;
  transform: rotate(-45deg);
}

.heart-outline::after {
  right: 6rpx;
  transform: rotate(45deg);
}

/* 已点赞状�?- 实心红色爱心 */
.icon-liked {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  transform: scale(0);
  transition: all 0.35s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.icon-liked:not(.hide) {
  opacity: 1;
  transform: scale(1);
  animation: heartBeat 0.6s ease-in-out;
}

.icon-liked.hide {
  opacity: 0;
  transform: scale(0);
}

.heart-filled {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FF4757 0%, #EE3333 100%);
  border-radius: 50%;
  position: relative;
  box-shadow: 0 4rpx 15rpx rgba(255, 71, 87, 0.4);
}

.heart-filled::before,
.heart-filled::after {
  content: '';
  position: absolute;
  width: 22rpx;
  height: 34rpx;
  background: inherit;
  border-radius: 22rpx 22rpx 0 0;
  top: 2rpx;
}

.heart-filled::before {
  left: 4rpx;
  transform: rotate(-45deg);
}

.heart-filled::after {
  right: 4rpx;
  transform: rotate(45deg);
}

/* 粒子爆炸效果 */
.heart-particles {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120rpx;
  height: 120rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: #FF4757;
  border-radius: 50%;
  opacity: 0;
}

.is-liked .particle {
  animation: particleExplode 0.6s ease-out forwards;
}

.p1 { top: 0; left: 50%; animation-delay: 0s; }
.p2 { top: 15%; right: 10%; animation-delay: 0.05s; }
.p3 { bottom: 15%; right: 10%; animation-delay: 0.1s; }
.p4 { bottom: 0; left: 50%; animation-delay: 0.15s; }
.p5 { bottom: 15%; left: 10%; animation-delay: 0.2s; }
.p6 { top: 15%; left: 10%; animation-delay: 0.25s; }

@keyframes particleExplode {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(var(--tx), var(--ty)) scale(0);
  }
}

.p1 { --tx: 0; --ty: -60rpx; }
.p2 { --tx: 50rpx; --ty: -40rpx; }
.p3 { --tx: 50rpx; --ty: 40rpx; }
.p4 { --tx: 0; --ty: 60rpx; }
.p5 { --tx: -50rpx; --ty: 40rpx; }
.p6 { --tx: -50rpx; --ty: -40rpx; }

/* 点赞数字 */
.like-num {
  font-size: 26rpx;
  color: #9CA3AF;
  font-weight: 600;
  transition: all 0.3s ease;
  min-width: 40rpx;
  text-align: center;
}

.like-num.liked-num {
  color: #FF4757;
  animation: numPop 0.3s ease;
}

/* 已点赞按钮样�?*/
.bili-like-btn.is-liked {
  background: linear-gradient(135deg, rgba(255, 71, 87, 0.08) 0%, rgba(238, 51, 51, 0.04) 100%);
}

/* ========== 青春可爱风格收藏按�?========== */
.bili-fav-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  background: transparent;
  border-radius: 40rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: visible;
}

.bili-fav-btn.fav-hover {
  transform: scale(0.95);
  opacity: 0.9;
}

.bili-fav-btn.animating {
  pointer-events: none;
}

/* 收藏图标容器 */
.fav-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 未收藏状�?- 空心星星 */
.icon-unfavored {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  transition: all 0.3s ease;
}

.icon-unfavored.hide {
  opacity: 0;
  transform: scale(0) rotate(-90deg);
}

.star-outline {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.star-outline::before {
  content: '☆';
  font-size: 44rpx;
  color: #9CA3AF;
  line-height: 1;
}

/* 已收藏状�?- 实心金色星星 */
.icon-favored {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  transform: scale(0) rotate(-90deg);
  transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.icon-favored:not(.hide) {
  opacity: 1;
  transform: scale(1) rotate(0deg);
  animation: starSpin 0.5s ease-out;
}

.icon-favored.hide {
  opacity: 0;
  transform: scale(0) rotate(-90deg);
}

.star-filled {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.star-filled::before {
  content: '★';
  font-size: 44rpx;
  line-height: 1;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2rpx 8rpx rgba(245, 158, 11, 0.5));
}

/* 星星闪光效果 */
.star-sparkles {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100rpx;
  height: 100rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.sparkle {
  position: absolute;
  font-size: 20rpx;
  color: #F59E0B;
  opacity: 0;
}

.is-favorited .sparkle {
  animation: sparkleAnim 0.8s ease-out forwards;
}

.s1 { top: 0; left: 50%; animation-delay: 0s; }
.s2 { top: 20%; right: 0; animation-delay: 0.1s; }
.s3 { bottom: 20%; right: 0; animation-delay: 0.2s; }
.s4 { bottom: 0; left: 50%; animation-delay: 0.3s; }

@keyframes sparkleAnim {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(0) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: translate(var(--sx), var(--sy)) scale(1.2) rotate(180deg);
  }
  100% {
    opacity: 0;
    transform: translate(var(--ex), var(--ey)) scale(0) rotate(360deg);
  }
}

.s1 { --sx: 0; --sy: -30rpx; --ex: 0; --ey: -50rpx; }
.s2 { --sx: 25rpx; --sy: -20rpx; --ex: 40rpx; --ey: -30rpx; }
.s3 { --sx: 25rpx; --sy: 20rpx; --ex: 40rpx; --ey: 30rpx; }
.s4 { --sx: 0; --sy: 30rpx; --ex: 0; --ey: 50rpx; }

/* 收藏数字 */
.fav-num {
  font-size: 26rpx;
  color: #9CA3AF;
  font-weight: 600;
  transition: all 0.3s ease;
  min-width: 40rpx;
  text-align: center;
}

.fav-num.favored-num {
  color: #F59E0B;
  animation: numPop 0.3s ease;
}

/* 已收藏按钮样�?*/
.bili-fav-btn.is-favorited {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(217, 119, 6, 0.04) 100%);
}

/* ========== 动画关键�?========== */
@keyframes heartBeat {
  0% { transform: scale(1); }
  25% { transform: scale(1.3); }
  50% { transform: scale(1); }
  75% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

@keyframes starSpin {
  0% { transform: scale(0) rotate(-90deg); }
  60% { transform: scale(1.2) rotate(15deg); }
  80% { transform: scale(0.95) rotate(-5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

@keyframes numPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* ========== 评论�?========== */
.comment-section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.section-title-bar {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1D29;
}

.comment-count {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* 评论列表 */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.08);
  border: 1rpx solid #F3F4F6;
}

.comment-author-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F3F4F6;
  flex-shrink: 0;
}

.comment-info-col {
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.comment-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-date {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.comment-body-wrap {
  padding-left: 80rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.65;
  word-break: break-all;
}

/* 空评论状�?*/
.empty-comment {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-emoji-box {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #F3F4F6 0%, #FFDDE8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 56rpx;
}

.empty-main-text {
  font-size: 30rpx;
  color: #6B7280;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-sub-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-dots-mini {
  display: flex;
  gap: 8rpx;
}

.mini-dot {
  width: 12rpx;
  height: 12rpx;
  background: #6366F1;
  border-radius: 50%;
  animation: dotBounce 1.4s infinite ease-in-out both;
}

.mini-dot.delay {
  animation-delay: -0.32s;
}

.mini-dot.delay-2 {
  animation-delay: -0.16s;
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 底部占位 */
.bottom-placeholder {
  height: 140rpx;
}

/* ========== 底部评论输入�?========== */
.bottom-comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.03);
}

.comment-input-area {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F8F9FE;
  border-radius: 48rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.comment-input-area:focus-within {
  background: #FFFFFF;
  border-color: #6366F1;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.1);
}

.input-box-wrapper {
  flex: 1;
  position: relative;
}

.comment-input-field {
  font-size: 28rpx;
  color: #1A1D29;
  height: 64rpx;
  line-height: 64rpx;
  background: transparent;
}

.input-placeholder {
  color: #9CA3AF;
  font-size: 28rpx;
}

.input-focus-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #6366F1, #8B5CF6);
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.comment-input-area:focus-within .input-focus-line {
  width: 100%;
}

/* 发送按�?*/
.send-btn {
  padding: 0 28rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 32rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  border: none !important;
  margin: 0 !important;
  transition: all 0.3s ease !important;
  min-width: 100rpx !important;
}

.send-btn.btn-disabled {
  background: #FFDDE8 !important;
  color: #9CA3AF !important;
}

.send-btn.btn-active {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%) !important;
  color: #FFFFFF !important;
  box-shadow: 0 4rpx 15rpx rgba(99, 102, 241, 0.35) !important;
}

.send-btn.btn-active:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.25) !important;
}

.send-btn-text {
  font-size: 26rpx;
  font-weight: 600;
}

/* 分享小按�?*/
.share-mini-btn {
  width: 72rpx !important;
  height: 72rpx !important;
  border-radius: 50% !important;
  background: #F8F9FE !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  transition: all 0.3s ease !important;
}

.share-mini-btn:active {
  background: #FFDDE8 !important;
  transform: scale(0.92);
}

.share-icon-text {
  font-size: 32rpx;
  color: #6B7280;
}

/* 举报按钮 */
.report-mini-btn {
  width: 72rpx !important;
  height: 72rpx !important;
  border-radius: 50% !important;
  background: #FFF5F5 !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1 !important;
  transition: all 0.3s ease !important;
}

.report-mini-btn:active {
  background: #FFE5E5 !important;
  transform: scale(0.92);
}

.report-icon-text {
  font-size: 30rpx;
}

/* ========== 加载中遮�?========== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner-large {
  width: 80rpx;
  height: 80rpx;
  position: relative;
  margin-bottom: 24rpx;
}

.spinner-ring {
  width: 100%;
  height: 100%;
  border: 5rpx solid #FFDDE8;
  border-top-color: #6366F1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-hint {
  font-size: 28rpx;
  color: #6B7280;
}

