/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #F8F9FE 100%);
  padding: 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 页面头部 */
.page-header {
  margin-bottom: 32rpx;
  padding: 8rpx 0;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1D29;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8691A6;
  font-weight: 400;
}

/* 表单卡片 */
.form-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 29, 41, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F8F9FE;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D29;
}

.title-icon {
  font-size: 34rpx;
}

.optional {
  font-size: 24rpx;
  color: #B0B8C9;
  font-weight: 400;
  margin-left: 8rpx;
}

/* 表单�?*/
.form-item {
  margin-bottom: 28rpx;
  position: relative;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: #3C404E;
  font-weight: 500;
}

.required {
  color: #FF4757;
  margin-left: 6rpx;
  font-size: 28rpx;
}

/* 输入�?*/
.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  background: #FAFBFC;
  border: 2rpx solid #E8ECF2;
  border-radius: 28rpx;
  font-size: 30rpx;
  color: #1A1D29;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus,
.form-input:focus-within {
  border-color: #4A90E2;
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.08);
}

.input-hint {
  position: absolute;
  right: 28rpx;
  bottom: -36rpx;
  font-size: 22rpx;
  color: #B0B8C9;
}

/* 选择�?*/
.picker-box {
  height: 88rpx;
  line-height: 84rpx;
  padding: 0 28rpx;
  background: #FAFBFC;
  border: 2rpx solid #E8ECF2;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
}

.picker-box.compact {
  height: 82rpx;
  line-height: 78rpx;
}

.datetime-row {
  display: flex;
  gap: 16rpx;
}

.datetime-picker {
  flex: 1;
}

.time-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.picker-box:active {
  border-color: #4A90E2;
  background: #FFFFFF;
}

.picker-value {
  font-size: 30rpx;
  color: #1A1D29;
}

.picker-value.placeholder-style {
  color: #B0B8C9;
}

.arrow {
  font-size: 36rpx;
  color: #B0B8C9;
  font-weight: 300;
}

/* 价格输入 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  background: #FAFBFC;
  border: 2rpx solid #E8ECF2;
  border-radius: 28rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.price-input-wrapper:focus-within {
  border-color: #4A90E2;
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.08);
}

.price-symbol {
  width: 80rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #FF6B35;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFEDE5 100%);
  height: 100%;
  line-height: 84rpx;
}

.price-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #FF6B35;
  background: transparent;
}

/* 文本�?*/
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx 28rpx;
  background: #FAFBFC;
  border: 2rpx solid #E8ECF2;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #1A1D29;
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-textarea:focus,
.form-textarea:focus-within {
  border-color: #4A90E2;
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.08);
}

.textarea-hint {
  text-align: right;
  font-size: 22rpx;
  color: #B0B8C9;
  margin-top: 12rpx;
  display: block;
}

/* 图片上传区域 */
.upload-section {
  padding-top: 8rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 28rpx;
  overflow: hidden;
  background: #F8F9FE;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-overlay {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(255, 71, 87, 0.85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.delete-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 1;
}

.add-image-btn {
  aspect-ratio: 1;
  border: 3rpx dashed #D1D8E0;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFBFC;
  transition: all 0.3s ease;
}

.add-image-btn:active {
  border-color: #4A90E2;
  background: #FFF5F7;
}

.plus-icon {
  font-size: 48rpx;
  color: #4A90E2;
  font-weight: 300;
  line-height: 1;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 500;
}

.count-hint {
  font-size: 20rpx;
  color: #B0B8C9;
  margin-top: 4rpx;
}

.upload-tips {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF5E6 100%);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #997A56;
  line-height: 1.8;
}

/* 提交区域 */
.submit-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E8ECF2;
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.35);
  position: relative;
  overflow: hidden;
}

.submit-btn::after {
  display: none;
}

.submit-btn.disabled {
  opacity: 0.65;
  box-shadow: none;
}

.btn-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.agreement {
  text-align: center;
  margin-top: 16rpx;
}

.agree-text {
  font-size: 22rpx;
  color: #B0B8C9;
}

.link {
  font-size: 22rpx;
  color: #4A90E2;
}

