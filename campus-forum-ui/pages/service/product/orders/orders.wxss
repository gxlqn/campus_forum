.container {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 20rpx;
  box-sizing: border-box;
}

.tab-row {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

.search-bar {
  margin-bottom: 16rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #eef2f7;
}

.search-icon {
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  padding: 0 8rpx;
  color: #94a3b8;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.tab-item.small {
  font-size: 24rpx;
}

.tab-item.active {
  background: #ffe8ef;
  color: #e84b80;
  font-weight: 600;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.order-no {
  font-size: 22rpx;
  color: #6b7280;
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
}

.status-1 {
  color: #f59e0b;
}

.status-0 {
  color: #7c3aed;
}

.status-2 {
  color: #9ca3af;
}

.status-3 {
  color: #10b981;
}

.status-4,
.status-5 {
  color: #ef4444;
}

.pending-hint {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #7c3aed;
  background: #f3e8ff;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
}

.order-body {
  display: flex;
  gap: 16rpx;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.body-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-title {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  line-height: 1.4;
}

.counterpart {
  font-size: 24rpx;
  color: #6b7280;
}

.amount {
  font-size: 30rpx;
  color: #ef4444;
  font-weight: 700;
}

.order-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  flex-wrap: wrap;
}

.meetup-box {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.meetup-line {
  display: block;
  font-size: 22rpx;
  color: #4b5563;
  line-height: 1.7;
}

.meetup-ok {
  color: #10b981;
  font-weight: 600;
}

.action-btn {
  min-width: 180rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  border-radius: 34rpx;
}

.action-btn.ghost {
  background: #fff;
  border: 1rpx solid #d1d5db;
  color: #374151;
}

.action-btn.primary {
  border: none;
  color: #fff;
  background: linear-gradient(135deg, #ff6b9d, #7c83ff);
}

.empty-state,
.loading-state {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.meetup-editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.meetup-editor {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.editor-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 18rpx;
}

.editor-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.editor-label {
  font-size: 26rpx;
  color: #334155;
}

.editor-value,
.picker-val {
  font-size: 26rpx;
  color: #0f172a;
}

.editor-value.placeholder {
  color: #94a3b8;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.editor-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.editor-btn.ghost {
  color: #334155;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
}

.editor-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  border: none;
}
