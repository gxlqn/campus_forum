.container { padding-bottom: 140rpx; }
.product-swiper { width: 100%; height: 600rpx; }
.swiper-image { width: 100%; height: 100%; }
.product-info { padding: 24rpx; margin: 20rpx; }
.price-row { margin-bottom: 16rpx; }
.price { font-size: 48rpx; font-weight: bold; color: #FF4D4F; }
.original-price { font-size: 28rpx; color: #999; text-decoration: line-through; margin-left: 16rpx; }
.product-title { font-size: 32rpx; font-weight: 500; color: #333; margin-bottom: 16rpx; }
.wanted-hint { margin-bottom: 12rpx; font-size: 22rpx; color: #7c3aed; background: #f3edff; padding: 10rpx 14rpx; border-radius: 12rpx; }
.wanted-status { margin-bottom: 12rpx; font-size: 24rpx; color: #475569; }
.wanted-time { margin-bottom: 12rpx; font-size: 24rpx; color: #0f766e; background: #ecfeff; border: 1rpx solid #bae6fd; border-radius: 10rpx; padding: 10rpx 14rpx; }
.product-meta { display: flex; gap: 24rpx; }
.meta-item { font-size: 24rpx; color: #999; background: #f5f5f5; padding: 8rpx 16rpx; border-radius: 28rpx; }
.product-desc { padding: 24rpx; margin: 0 20rpx 20rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.desc-content { font-size: 28rpx; color: #666; line-height: 1.8; }
.trade-info { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #eee; }
.info-item { display: block; font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.seller-info { padding: 24rpx; margin: 0 20rpx 20rpx; }
.seller-row { display: flex; align-items: center; }
.seller-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; }
.seller-detail { flex: 1; }
.seller-name { font-size: 28rpx; font-weight: 500; color: #333; display: block; }
.seller-college { font-size: 24rpx; color: #999; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 20rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05); }
.action-btns { display: flex; gap: 20rpx; }
.action-btn { flex: 1; height: 88rpx; border-radius: 44rpx; font-size: 30rpx; border: none; }
.action-btn.primary { background: linear-gradient(135deg, #4A90D9, #6BA3E0); color: #fff; }
.action-btn[disabled] { opacity: 0.7; }
.report-float-btn { position: absolute; right: 20rpx; top: -60rpx; font-size: 24rpx; color: #e74c3c; padding: 10rpx 20rpx; border-radius: 30rpx; background: #fff5f5; }
.wanted-owner-actions { display: flex; gap: 16rpx; padding: 0 20rpx 20rpx; background: #fff; }
.owner-btn { flex: 1; height: 72rpx; border-radius: 16rpx; font-size: 26rpx; background: #f1f5f9; color: #334155; }
.owner-btn.primary { background: linear-gradient(135deg, #0f766e, #14b8a6); color: #fff; }

