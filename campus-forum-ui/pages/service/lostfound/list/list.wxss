/* 失物招领列表样式 */

.container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部固定�?*/
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #FFFFFF;
  padding: 20rpx 30rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}

.search-box {
  background-color: #F8F9FE;
  border-radius: 36rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.search-box icon {
  margin-right: 12rpx;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  height: 80rpx;
  line-height: 80rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #333;
  font-weight: 500;
  font-size: 30rpx;
}

.indicator {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #4A90D9; /* 主题�?*/
  border-radius: 4rpx;
}

/* 列表容器 */
.list-container {
  padding: 30rpx;
  padding-bottom: 150rpx; /* 为悬浮按钮留出空�?*/
}

/* 卡片样式 */
.lost-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 28rpx;
}

.card-header {
  margin-bottom: 20rpx;
}

.header-left {
  flex: 1;
  margin-right: 20rpx;
}

.type-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.type-tag.lost {
  background-color: rgba(255, 77, 79, 0.1);
  color: #FF4D4F;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.type-tag.found {
  background-color: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border: 1rpx solid rgba(7, 193, 96, 0.2);
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.status-tag {
  font-size: 22rpx;
  color: #999;
  background-color: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.item-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.item-images {
  position: relative;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  background-color: #F0F0F0;
}

.img-count {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  background-color: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 28rpx;
}

/* 底部信息 */
.location-row {
  margin-bottom: 16rpx;
}

.icon-wrap {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 26rpx;
  color: #4A90D9;
}

.info-row {
  margin-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
  padding-top: 20rpx;
}

.avatar-xs {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background-color: #eee;
}

.nickname {
  font-size: 24rpx;
  color: #666;
}

.time {
  font-size: 22rpx;
  color: #999;
}

/* 悬浮发布按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A90D9, #6BA3E0);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.4);
  color: #fff;
}

.fab-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.fab-text {
  font-size: 20rpx;
}

/* 空状�?*/
.empty-box {
  text-align: center;
  padding: 100rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 20rpx;
}

/* 文本截断工具�?*/
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

