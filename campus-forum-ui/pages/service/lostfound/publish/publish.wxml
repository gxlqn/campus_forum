<!-- pages/service/lostfound/publish/publish.wxml -->
<view class="container">
  <!-- 类型选择 -->
  <view class="type-selector flex">
    <view class="type-item {{type === 1 ? 'active lost' : ''}}" bindtap="switchType" data-type="1">
      <text class="icon">🔍</text>
      <text>寻物信息</text>
    </view>
    <view class="type-item {{type === 2 ? 'active found' : ''}}" bindtap="switchType" data-type="2">
      <text class="icon">📦</text>
      <text>招领信息</text>
    </view>
  </view>

  <view class="form-container">
    <!-- 标题 -->
    <view class="form-item">
      <view class="label">标题</view>
      <input class="input" placeholder="请输入物品名称，例如：黑色皮革钱包" value="{{title}}" data-field="title" bindinput="onInput"/>
    </view>

    <!-- 物品类型 - 改用 Picker -->
    <view class="form-item">
      <view class="label">物品类型</view>
      <picker mode="selector" range="{{tags}}" bindchange="onTagChange">
        <view class="picker-text {{itemName ? '' : 'placeholder'}}">
          {{itemName || '选择物品类型'}}
        </view>
      </picker>
    </view>

    <!-- 详细描述 -->
    <view class="form-item no-border">
      <view class="label">详细描述</view>
      <textarea class="textarea" placeholder="请详细描述物品特征、丢失/拾取地点..." value="{{desc}}" data-field="desc" bindinput="onInput" maxlength="500"></textarea>

      <!-- 图片上传 -->
      <view class="image-list">
        <view class="image-item" wx:for="{{images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill"></image>
          <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="chooseImage" wx:if="{{images.length < 3}}">
          <text class="camera-icon">📷</text>
          <text class="upload-text">上传图片</text>
        </view>
      </view>
      <view class="upload-tip" wx:if="{{images.length > 0}}">已选择 {{images.length}}/3 张图片</view>
    </view>

    <!-- 时间地点 -->
    <view class="section-title">时间地点</view>

    <!-- 地点选择 -->
    <view class="form-item arrow" bindtap="chooseLocation">
      <view class="label">地点</view>
      <view class="picker-text {{location ? '' : 'placeholder'}}">{{location || '选择丢失/拾取地点'}}</view>
    </view>

    <!-- 日期选择 -->
    <view class="form-item">
      <view class="label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="bindDateChange">
        <view class="picker-text">{{date}}</view>
      </picker>
    </view>

    <!-- 时间选择 -->
    <view class="form-item">
      <view class="label">时间</view>
      <picker mode="time" value="{{time}}" bindchange="bindTimeChange">
        <view class="picker-text">{{time}}</view>
      </picker>
    </view>

    <!-- 联系方式 -->
    <view class="section-title">联系方式</view>

    <view class="form-item">
      <view class="label">联系人/电话</view>
      <input class="input" placeholder="请输入联系方式" value="{{contact}}" data-field="contact" bindinput="onInput"/>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="footer-btn">
    <button class="submit-btn" bindtap="submit" loading="{{uploading}}" disabled="{{uploading}}">
      {{uploading ? '发布中...' : '发布信息'}}
    </button>
  </view>
</view>