/* 失物招领发布页样�?*/

.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 类型选择 */
.type-selector {
  padding: 30rpx;
  background-color: #fff;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.type-item {
  width: 48%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F8F9FE;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  transition: all 0.3s;
}

.type-item .icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.type-item.active.lost {
  background-color: rgba(255, 77, 79, 0.05);
  border-color: #FF4D4F;
  color: #FF4D4F;
}

.type-item.active.found {
  background-color: rgba(7, 193, 96, 0.05);
  border-color: #07C160;
  color: #07C160;
}

/* 表单区域 */
.form-container {
  background-color: #fff;
  padding: 0 30rpx;
}

.section-title {
  padding: 30rpx 0 10rpx;
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  font-size: 30rpx;
}

.form-item.no-border {
  border-bottom: none;
  display: block;
}

.form-item.arrow {
  position: relative;
  padding-right: 30rpx;
}

.form-item.arrow::after {
  content: ">";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  color: #CCC;
  font-size: 36rpx;
}

.label {
  width: 160rpx;
  color: #333;
  font-weight: 500;
}

.input, .picker-text {
  flex: 1;
  color: #333;
}

.placeholder {
  color: #CCC;
}

.textarea {
  width: 100%;
  height: 200rpx;
  margin-top: 20rpx;
  color: #333;
  font-size: 30rpx;
  line-height: 1.6;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-bottom: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0,0,0,0.5);
  color: #fff;
  text-align: center;
  line-height: 38rpx;
  border-bottom-left-radius: 12rpx;
  font-size: 28rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #F8F9FE;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.camera-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
}

/* 底部按钮 */
.footer-btn {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 99;
}

.submit-btn {
  background: linear-gradient(135deg, #4A90D9, #6BA3E0);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
}

.submit-btn[disabled] {
  background: #CCC;
  color: #FFF;
}


