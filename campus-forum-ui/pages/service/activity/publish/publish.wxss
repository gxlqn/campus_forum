.container {
  min-height: 100vh;
  background: #f8f9fe;
  padding: 28rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
}

.input,
.textarea,
.picker-row {
  background: #fff;
  border: 1rpx solid #efe6eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input {
  height: 88rpx;
  padding: 0 22rpx;
}

.textarea {
  width: 100%;
  height: 220rpx;
  padding: 18rpx 22rpx;
}

.picker-row {
  min-height: 88rpx;
  padding: 0 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-grid {
  display: flex;
  gap: 12rpx;
}

.picker-half {
  width: 100%;
}

.placeholder {
  color: #bbb;
}

.value-text {
  color: #333;
}

.arrow {
  color: #bbb;
  font-size: 30rpx;
}

.submit-btn {
  margin-top: 36rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 32rpx;
  background: linear-gradient(135deg, #ff6b9d, #ff8a80);
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 157, 0.34);
}

.submit-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}
