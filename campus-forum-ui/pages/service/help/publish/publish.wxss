.container {
  padding: 30rpx;
  background: #f8f9fe;
  min-height: 100vh;
}

.form-group {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
  margin-left: 4rpx;
}

.input {
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
}

.textarea {
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  height: 200rpx;
  border: 1rpx solid #eee;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.value-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.placeholder {
  font-size: 28rpx;
  color: #bbb;
  flex: 1;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 10rpx;
}

.wallet-confirm {
  padding: 24rpx;
  background: linear-gradient(135deg, #fffcf8, #fff5eb);
  border-radius: 16rpx;
  margin: 40rpx 0;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ffe7cc;
}

.highlight {
  color: #ff6b9d;
  font-weight: bold;
  font-size: 34rpx;
}

.hint {
  margin-top: 12rpx;
  color: #e6a23c;
  font-size: 24rpx;
}

.btn-submit {
  background: linear-gradient(135deg, #FF6B9D, #FF8A80);
  color: #fff;
  border-radius: 100rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.35);
}

.btn-submit[disabled] {
  background: #ccc;
  box-shadow: none;
}