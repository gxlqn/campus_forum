.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #f6f8fb 100%);
}

.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.search-bar {
  padding: 20rpx 28rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 12rpx;
}

.user-count {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 0;
}

.filter-hint {
  color: #667eea;
  margin-left: 6rpx;
}

.user-list {
  height: calc(100vh - 420rpx);
  padding: 0 28rpx;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid rgba(102, 126, 234, 0.15);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.user-card-wrap {
  margin-bottom: 18rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.user-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.user-card.current {
  background: linear-gradient(135deg, #eef2ff, #FFF5F7);
  border: 2rpx solid #667eea;
}

.user-card.switching {
  opacity: 0.7;
  pointer-events: none;
}

.card-left {
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  object-fit: cover;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.1);
}

.badge-current {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}

.card-center {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.user-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.tag-row {
  display: flex;
  gap: 8rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

.status-tag.active {
  background: #d1fae5;
  color: #059669;
}

.status-tag.disabled {
  background: #fee2e2;
  color: #dc2626;
}

.verify-tag {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 28rpx;
  background: #fef3c7;
  color: #d97706;
}

.user-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
}

.info-label {
  color: #999;
  margin-right: 4rpx;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.user-time {
  font-size: 22rpx;
  color: #aaa;
}

.card-right {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.switch-btn {
  width: 110rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.35);
}

.btn-loading {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

.current-badge {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.bottom-tip {
  padding: 30rpx 28rpx;
  text-align: center;
}

.tip-text {
  font-size: 22rpx;
  color: #999;
}
