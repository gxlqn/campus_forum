/* pages/auth/login/login.wxss */
page {
  background: linear-gradient(180deg, #FFF5F7 0%, #FFF0F5 50%, #F8F9FE 100%);
}

/* ========== 容器与背景 ========== */
.login-container {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #FFF5F7 0%, #FFF0F5 50%, #F8F9FE 100%);
}

/* 装饰气泡 */
.deco-bubble {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  animation: float 6s ease-in-out infinite;
}

.bubble-1 {
  width: 320rpx;
  height: 320rpx;
  top: -80rpx;
  left: -100rpx;
  background: radial-gradient(circle, rgba(255, 107, 157, 0.25) 0%, rgba(255, 107, 157, 0) 70%);
  animation-delay: 0s;
}

.bubble-2 {
  width: 400rpx;
  height: 400rpx;
  right: -150rpx;
  top: 30%;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.2) 0%, rgba(167, 139, 250, 0) 70%);
  animation-delay: 2s;
}

.bubble-3 {
  width: 280rpx;
  height: 280rpx;
  left: 10%;
  bottom: 20%;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.15) 0%, rgba(251, 191, 36, 0) 70%);
  animation-delay: 4s;
}

/* 装饰星光 */
.deco-sparkle {
  position: absolute;
  font-size: 32rpx;
  color: #FF6B9D;
  opacity: 0.6;
  z-index: 0;
  animation: twinkle 3s ease-in-out infinite;
}

.sparkle-1 {
  top: 15%;
  right: 15%;
  animation-delay: 0.5s;
}

.sparkle-2 {
  top: 45%;
  left: 8%;
  font-size: 24rpx;
  color: #A78BFA;
  animation-delay: 1.5s;
}

.sparkle-3 {
  bottom: 35%;
  right: 10%;
  font-size: 28rpx;
  color: #FBBF24;
  animation-delay: 2.5s;
}

/* ========== 内容滚动区域 ========== */
.content-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
}

.main-wrapper {
  min-height: 100%;
  box-sizing: border-box;
  padding: 80rpx 40rpx 40rpx;
}

/* ========== 品牌区域 ========== */
.brand-section {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
  animation: slideIn 0.6s ease-out;
}

.brand-logo-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.brand-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FAB 100%);
  box-shadow:
    0 12rpx 32rpx rgba(255, 107, 157, 0.35),
    0 4rpx 12rpx rgba(167, 139, 250, 0.15),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
  position: relative;
  overflow: hidden;
  z-index: 2;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.logo-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.3) 50%,
    transparent 70%
  );
  animation: shine 3s ease-in-out infinite;
}

.brand-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 34rpx;
  border: 3rpx solid rgba(255, 107, 157, 0.3);
  z-index: 1;
}

.brand-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 36rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  color: #4A4A4A;
  line-height: 1.3;
}

.brand-subtitle {
  font-size: 22rpx;
  margin-top: 6rpx;
  color: #9CA3AF;
  letter-spacing: 1rpx;
  font-weight: 500;
}

/* ========== 欢迎标题区域 ========== */
.welcome-section {
  margin-bottom: 48rpx;
  animation: slideIn 0.75s ease-out;
}

.welcome-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFE4EC, #FFDDE8);
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.15);
}

.badge-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #E11D48;
  letter-spacing: 1rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.title-line {
  display: block;
  font-size: 56rpx;
  line-height: 1.2;
  letter-spacing: 2rpx;
  font-weight: 800;
  color: #4A4A4A;
}

.line-1 {
  color: #4A4A4A;
  font-size: 48rpx;
}

.line-2 {
  background: linear-gradient(135deg, #FF6B9D 0%, #A78BFA 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-size: 64rpx;
  font-weight: 900;
}

.line-3 {
  color: #A78BFA;
  font-size: 56rpx;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #9CA3AF;
  letter-spacing: 2rpx;
}

/* ========== 功能特色网格 ========== */
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
  animation: slideIn 0.9s ease-out;
}

.feature-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 8rpx 24rpx rgba(255, 107, 157, 0.08),
    0 2rpx 8rpx rgba(167, 139, 250, 0.05),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 32rpx 32rpx 0 0;
  opacity: 0.7;
}

.feature-card:nth-child(1)::before {
  background: linear-gradient(90deg, #FF6B9D, #FF8FAB);
}

.feature-card:nth-child(2)::before {
  background: linear-gradient(90deg, #A78BFA, #C4B5FD);
}

.feature-card:nth-child(3)::before {
  background: linear-gradient(90deg, #FBBF24, #FCD34D);
}

.feature-card:nth-child(4)::before {
  background: linear-gradient(90deg, #34D399, #6EE7B7);
}

.card-hover {
  transform: scale(0.96) translateY(-4rpx);
  box-shadow:
    0 12rpx 32rpx rgba(255, 107, 157, 0.15),
    0 4rpx 12rpx rgba(167, 139, 250, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
}

.feature-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.icon-forum {
  background: linear-gradient(135deg, #FFE4EC, #FFF0F5);
}

.icon-market {
  background: linear-gradient(135deg, #EDE9FE, #F5F3FF);
}

.icon-lost {
  background: linear-gradient(135deg, #FEF3C7, #FEF9C3);
}

.icon-help {
  background: linear-gradient(135deg, #D1FAE5, #ECFDF5);
}

.feature-icon {
  font-size: 40rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A4A4A;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #9CA3AF;
  letter-spacing: 1rpx;
}

/* ========== 标语卡片 ========== */
.slogan-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow:
    0 12rpx 36rpx rgba(255, 107, 157, 0.06),
    0 4rpx 12rpx rgba(167, 139, 250, 0.03),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  animation: slideIn 1.05s ease-out;
}

.slogan-decoration {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  display: flex;
  gap: 8rpx;
}

.deco-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-1 {
  background: #FF6B9D;
}

.dot-2 {
  background: #A78BFA;
}

.dot-3 {
  background: #FBBF24;
}

.slogan-text {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.slogan-sub {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

/* ========== 登录操作区域 ========== */
.action-section {
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 2;
  background: linear-gradient(180deg, rgba(248, 249, 254, 0) 0%, rgba(248, 249, 254, 0.9) 30%, rgba(248, 249, 254, 1) 100%);
}

.action-inner {
  max-width: 680rpx;
  margin: 0 auto;
}

/* ========== 登录按钮 ========== */
.login-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 56rpx;
  border: none;
  box-sizing: border-box;
  padding: 0;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FAB 50%, #FF6B9D 100%);
  background-size: 200% 100%;
  box-shadow:
    0 12rpx 32rpx rgba(255, 107, 157, 0.4),
    0 4rpx 12rpx rgba(255, 107, 157, 0.2),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  animation: gradientMove 3s ease infinite;
}

.login-btn::after {
  border: none;
}

.btn-hover {
  transform: scale(0.96);
  box-shadow:
    0 6rpx 16rpx rgba(255, 107, 157, 0.3),
    0 2rpx 8rpx rgba(255, 107, 157, 0.15);
}

.btn-loading {
  opacity: 0.8;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 0 40rpx;
}

.btn-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  backdrop-filter: blur(10px);
}

.wechat-icon {
  font-size: 36rpx;
}

.btn-text {
  flex: 1;
  text-align: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.btn-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(10px);
}

.arrow-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.btn-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.2) 50%,
    transparent 70%
  );
  animation: shine 4s ease-in-out infinite;
}

/* ========== 底部信息 ========== */
.footer-info {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.security-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.security-icon {
  font-size: 24rpx;
}

.security-text {
  font-size: 22rpx;
  color: #6B7280;
  letter-spacing: 1rpx;
}

.legal-links {
  display: flex;
  align-items: center;
}

.legal-link {
  font-size: 22rpx;
  color: #FF6B9D;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.legal-divider {
  padding: 0 12rpx;
  color: #D1D5DB;
  font-size: 20rpx;
}

/* ========== 动画关键帧 ========== */
@keyframes slideIn {
  from {
    transform: translateY(30rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.05);
  }
}

@keyframes twinkle {
  0%, 100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

@keyframes shine {
  0% {
    transform: translateX(-100%) translateY(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) translateY(100%) rotate(45deg);
  }
}

@keyframes gradientMove {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
